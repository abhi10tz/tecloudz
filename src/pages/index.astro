---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/date';
import { generateOrganizationSchema } from '../utils/schema';

const allPosts = await getCollection('posts');

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredPost = sortedPosts.find((p) => p.data.featured);
const listPosts = sortedPosts.filter((p) => p.id !== featuredPost?.id);

const schemaData = generateOrganizationSchema(Astro.site?.href ?? 'https://tecloudz.com');

function readTime(body: string): number {
  const words = body?.trim().split(/\s+/).length ?? 0;
  return Math.max(1, Math.round(words / 200));
}

function readDots(mins: number) {
  const total = 5;
  const filled = Math.min(mins, total);
  return { filled, empty: total - filled };
}
---

<Layout
  title="tecloudz | Tech stories that matter"
  description="Privacy-first tech news, Linux guides, and open-source deep dives."
  activeNav="home"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <main>
    {
      featuredPost && (
        <section class="hero" aria-label="Featured Story">
          <a href={`/posts/${featuredPost.id}`} class="hero-link">
            <div class="hero-badge">
              <span class="hero-dot" aria-hidden="true" />
              Featured Story &mdash; {formatDate(featuredPost.data.date)}
            </div>
            <article class="hero-card">
              <h1>{featuredPost.data.title}</h1>
              {featuredPost.data.description && (
                <p class="lead">{featuredPost.data.description}</p>
              )}
              <div class="hero-meta">
                <span class="cat-badge">{featuredPost.data.category}</span>
                <span class="meta-text">by {featuredPost.data.author}</span>
                {featuredPost.body && (() => {
                  const mins = readTime(featuredPost.body);
                  const { filled, empty } = readDots(mins);
                  return (
                    <span class="read-time" aria-label={`${mins} minute read`}>
                      <span class="dots" aria-hidden="true">
                        {Array.from({ length: filled }).map(() => (
                          <span class="dot filled" />
                        ))}
                        {Array.from({ length: empty }).map(() => (
                          <span class="dot" />
                        ))}
                      </span>
                      {mins} min read
                    </span>
                  );
                })()}
                <span class="read-more" aria-hidden="true">Read &rarr;</span>
              </div>
            </article>
          </a>
        </section>
      )
    }

    {
      listPosts.length > 0 && (
        <section aria-label="Latest posts">
          <div class="section-header">
            <span class="section-label">Latest</span>
            <div class="section-rule" aria-hidden="true" />
          </div>

          <div class="feed">
            {listPosts.map((post) => {
              const mins = post.body ? readTime(post.body) : 1;
              const { filled, empty } = readDots(mins);
              return (
                <article class="feed-item">
                  <a href={`/posts/${post.id}`} class="feed-link">
                    <div class="item-left">
                      <time class="item-date" datetime={post.data.date.toISOString()}>
                        {formatDate(post.data.date)}
                      </time>
                      <span class="item-cat">{post.data.category}</span>
                    </div>
                    <div class="item-right">
                      <h2 class="item-title">{post.data.title}</h2>
                      {post.data.description && (
                        <p class="item-desc">{post.data.description}</p>
                      )}
                      <span class="read-time" aria-label={`${mins} minute read`}>
                        <span class="dots" aria-hidden="true">
                          {Array.from({ length: filled }).map(() => (
                            <span class="dot filled" />
                          ))}
                          {Array.from({ length: empty }).map(() => (
                            <span class="dot" />
                          ))}
                        </span>
                        {mins} min
                      </span>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      )
    }
  </main>
</Layout>

<style>
  /* ── Hero / Featured ─────────────────────────────── */
  .hero {
    margin-bottom: 2.75rem;
  }

  .hero-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .hero-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .hero-card {
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background: var(--surface-1);
    padding: 1.5rem;
    transition: border-color 0.2s;
  }

  .hero-link:hover .hero-card {
    border-color: var(--border-strong);
  }

  .hero-link:hover h1 {
    color: var(--accent);
  }

  h1 {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text-main);
    margin: 0 0 0.6rem;
    transition: color 0.15s;
  }

  .lead {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1rem;
    font-family: var(--font-body);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cat-badge {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--surface-2);
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .meta-text {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .read-more {
    margin-left: auto;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
  }

  /* ── Read time dots ──────────────────────────────── */
  .read-time {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .dots {
    display: inline-flex;
    gap: 2px;
    align-items: center;
  }

  .dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .dot.filled {
    background: var(--text-muted);
  }

  /* ── Section header ──────────────────────────────── */
  .section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0;
  }

  .section-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--border-color);
  }

  /* ── Feed ────────────────────────────────────────── */
  .feed {
    display: flex;
    flex-direction: column;
  }

  .feed-item {
    border-bottom: 1px solid var(--border-color);
  }

  .feed-item:last-child {
    border-bottom: none;
  }

  .feed-link {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 0 1rem;
    padding: 1rem 0;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s;
    align-items: start;
  }

  .feed-link:hover {
    opacity: 0.72;
  }

  .feed-link:hover .item-title {
    color: var(--accent);
  }

  .item-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 2px;
  }

  .item-date {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.4;
    opacity: 0.7;
  }

  .item-cat {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.8;
  }

  .item-right {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .item-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-main);
    line-height: 1.35;
    margin: 0;
    transition: color 0.15s;
  }

  .item-desc {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 600px) {
    h1 {
      font-size: 1.35rem;
    }

    .feed-link {
      grid-template-columns: 75px 1fr;
      gap: 0 0.75rem;
    }

    .read-more {
      display: none;
    }
  }
</style>