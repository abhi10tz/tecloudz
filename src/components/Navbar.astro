---
interface Props {
  active?: 'home' | 'posts' | 'about';
}

const { active } = Astro.props;
---

<header class="navbar">
  <div class="logo"><a href="/">tecloudz.</a></div>
  <nav class="nav-cluster">
    <div class="nav-links">
      <a
        href="/"
        class={active === 'home' ? 'active' : ''}
        aria-current={active === 'home' ? 'page' : undefined}>Home</a
      >
      <a
        href="/posts"
        class={active === 'posts' ? 'active' : ''}
        aria-current={active === 'posts' ? 'page' : undefined}>Posts</a
      >
      <a
        href="/about"
        class={active === 'about' ? 'active' : ''}
        aria-current={active === 'about' ? 'page' : undefined}>About</a
      >
    </div>
  </nav>
</header>

<style>
  .navbar {
    width: 100%;
    padding: 2rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo a {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--text-main);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .nav-cluster {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--surface-1) 85%, transparent);
    box-shadow: var(--shadow-soft);
  }

  .nav-links a {
    font-family: var(--font-heading);
    margin-left: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .nav-links a:hover {
    color: var(--accent);
    background: var(--hover-bg);
  }

  .nav-links a.active {
    color: var(--text-main);
    background: var(--surface-2);
  }

  @media (max-width: 600px) {
    .navbar {
      padding-top: 1.5rem;
      padding-bottom: 2rem;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .nav-cluster {
      width: 100%;
      justify-content: space-between;
    }

    .nav-links {
      flex-wrap: wrap;
      box-shadow: none;
    }
  }
</style>
