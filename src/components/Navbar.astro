---
interface Props {
  active?: 'home' | 'posts' | 'about';
}

const { active } = Astro.props;
---

<header class="navbar">
  <div class="logo"><a href="/">tecloudz.</a></div>
  <nav class="nav-cluster">
    <div class="nav-links">
      <a
        href="/"
        class={active === 'home' ? 'active' : ''}
        aria-current={active === 'home' ? 'page' : undefined}>Home</a
      >
      <a
        href="/posts"
        class={active === 'posts' ? 'active' : ''}
        aria-current={active === 'posts' ? 'page' : undefined}>Posts</a
      >
      <a
        href="/about"
        class={active === 'about' ? 'active' : ''}
        aria-current={active === 'about' ? 'page' : undefined}>About</a
      >
    </div>
    <button type="button" class="theme-toggle" data-theme-toggle data-mode="system" aria-label="Theme: System">
      <span class="theme-icon" data-theme-icon aria-hidden="true"></span>
      <span class="sr-only" data-theme-text>System</span>
    </button>
  </nav>
</header>

<style>
  .navbar {
    width: 100%;
    padding: 2rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo a {
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--text-main);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .nav-cluster {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--surface-1) 85%, transparent);
    box-shadow: var(--shadow-soft);
  }

  .nav-links a {
    margin-left: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .nav-links a:hover {
    color: var(--accent);
    background: var(--hover-bg);
  }

  .nav-links a.active {
    color: var(--text-main);
    background: var(--surface-2);
  }

  .theme-toggle {
    border: 1px solid var(--border-color);
    background: var(--surface-1);
    color: var(--text-main);
    border-radius: var(--radius-md);
    padding: 0.42rem 0.65rem;
    width: 2.2rem;
    height: 2.2rem;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    background: var(--hover-bg);
  }

  .theme-icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
  }

  .theme-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 600px) {
    .navbar {
      padding-top: 1.5rem;
      padding-bottom: 2rem;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .nav-cluster {
      width: 100%;
      justify-content: space-between;
    }

    .nav-links {
      flex-wrap: wrap;
      box-shadow: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const themeKey = 'tecloudz-theme';
    const modes = ['system', 'light', 'dark'];
    const icons = {
      system:
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 20h8"></path></svg>',
      light:
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>',
      dark:
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a8.5 8.5 0 1 0 8.5 8.5A7 7 0 0 1 12 3z"></path></svg>'
    };

    const getMode = () => {
      const current = document.documentElement.getAttribute('data-theme') || 'system';
      return modes.includes(current) ? current : 'system';
    };

    const setMode = (mode) => {
      const safeMode = modes.includes(mode) ? mode : 'system';
      document.documentElement.setAttribute('data-theme', safeMode);
      try {
        localStorage.setItem(themeKey, safeMode);
      } catch {}
      return safeMode;
    };

    const labelMap = {
      system: 'System',
      light: 'Light',
      dark: 'Dark'
    };

    const updateButton = (button) => {
      const mode = getMode();
      const label = labelMap[mode];
      button.setAttribute('data-mode', mode);
      button.setAttribute('aria-label', `Theme: ${label}`);
      button.setAttribute('title', `Theme mode: ${label}`);
      const textNode = button.querySelector('[data-theme-text]');
      if (textNode) textNode.textContent = label;
      const iconNode = button.querySelector('[data-theme-icon]');
      if (iconNode) iconNode.innerHTML = icons[mode] || icons.system;
    };

    const mount = () => {
      const button = document.querySelector('[data-theme-toggle]');
      if (!button || button.getAttribute('data-bound') === 'true') return;

      button.addEventListener('click', () => {
        const currentIndex = modes.indexOf(getMode());
        const nextMode = modes[(currentIndex + 1) % modes.length];
        setMode(nextMode);
        updateButton(button);
      });

      button.setAttribute('data-bound', 'true');
      updateButton(button);
    };

    document.addEventListener('astro:page-load', mount);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mount);
    } else {
      mount();
    }
  })();
</script>
