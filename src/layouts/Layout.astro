---
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  activeNav?: 'home' | 'posts' | 'about';
}

const {
  title,
  description = 'Cutting-edge tech stories that matter. Privacy-first news, tutorials, and guides.',
  image,
  activeNav
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(
  typeof image === 'string' ? image : (image?.src || '/favicon.svg'),
  Astro.site
);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#09090b" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="tecloudz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
  </head>
  <body>
    <div class="site-wrapper">
      <Navbar active={activeNav} />

      <div class="page-content">
        <slot />
      </div>

      <footer class="minimal-footer">
        <div class="footer-links">
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/about">About</a>
          <a
            href="https://mastodon.social/@tecloudz"
            target="_blank"
            rel="me noopener noreferrer"
            aria-label="Mastodon"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 512 512"
              fill="currentColor"
              class="lucide lucide-mastodon"
              aria-hidden="true"
              ><path
                d="M433 179.11c0-97.2-63.71-125.7-63.71-125.7-62.52-28.7-228.56-28.4-290.48 0 0 0-63.72 28.5-63.72 125.7 0 115.7-6.6 259.4 105.63 289.1 40.51 10.7 75.32 13 103.33 11.4 50.81-2.8 79.32-18.1 79.32-18.1l-1.7-36.9s-36.31 11.4-77.12 10.1c-40.41-1.4-83-4.4-89.63-54a102.54 102.54 0 0 1-.9-13.9c85.63 20.9 158.65 9.1 178.75 6.7 56.12-6.7 105-41.3 111.23-72.9 9.8-49.8 9-121.5 9-121.5zm-75.12 125.2h-46.63v-114.2c0-49.7-64-51.6-64 6.9v62.5h-46.33V197c0-58.5-64-56.6-64-6.9v114.2H90.19c0-122.1-5.2-147.9 18.41-175 25.9-28.9 79.82-30.8 103.83 6.1l11.6 19.5 11.6-19.5c24.11-37.1 78.12-34.8 103.83-6.1 23.71 27.3 18.4 53 18.4 175z"
              ></path></svg
            >
          </a>
        </div>
        <p>&copy; {currentYear} tecloudz</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .site-wrapper {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3vw, 1.75rem);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-content {
    flex: 1;
    width: 100%;
    padding-bottom: 1rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-heading);
  }

  .footer-links a {
    display: flex;
    align-items: center;
  }

  .footer-links a svg {
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .footer-links a:hover svg {
    opacity: 1;
  }

  .minimal-footer p {
    font-family: var(--font-heading);
    margin: 0;
  }
</style>
